#jinja2: trim_blocks: True, lstrip_blocks: True
# {{ ansible_managed }}
# Point d'entree Compose pour Travel-Plan.
# Assemble les fragments rendus par les roles Ansible postgres / vault / neo4j.
# Réseaux créés par Ansible (community.docker.docker_network) — externes à Compose.
#
# PROFILS (cf. docs/architecture-decisions.md §4) :
#   core : postgres + vault (dev quotidien, ~350 Mo, laisse place à IDE + navigateur)
#   full : postgres + vault + neo4j (intégration + démo, IDE fermé)
#   ci   : jenkins (+ traefik pour joindre son UI) — À LA DEMANDE (docs §8) :
#          la stack CI ne cohabite PAS avec la stack applicative sur 8 Go.
#
# USAGE :
#   docker compose --profile core up -d    # dev quotidien
#   docker compose --profile full up -d    # stack complète
#   docker compose --profile ci   up -d    # CI seule (stack applicative down)
#   docker compose --profile full down     # nettoyage

include:
  - path: {{ assembly_postgres_fragment }}
  - path: {{ assembly_vault_fragment }}
  - path: {{ assembly_neo4j_fragment }}
  # traefik : la GATEWAY, rôle Ansible stable (fragment rendu sous
  # {{ assembly_compose_dir }}/traefik/). Inclus SANS flag conditionnel — contrairement
  # à identity, ce n'est pas un fragment statique optionnel du dépôt à chemin variable.
  - path: {{ assembly_traefik_fragment }}
{% if assembly_jenkins_enabled %}
  # jenkins : fragment RENDU par le rôle Ansible `jenkins` sous
  # {{ assembly_compose_dir }}/jenkins/ — donc chemin RELATIF, comme postgres/
  # vault/neo4j/traefik (et NON un chemin absolu comme identity/payment/travel).
  # Gardé derrière un flag car les `include:` sont résolus quel que soit le
  # --profile : sans le rôle joué, l'include casserait AUSSI core et full.
  - path: {{ assembly_jenkins_fragment }}
{% endif %}
{% if assembly_identity_enabled %}
  # identity-service : fragment STATIQUE du dépôt (build depuis les sources),
  # référencé par CHEMIN ABSOLU (co-localisé avec Dockerfile + src/), pas rendu
  # sous {{ assembly_compose_dir }}. Activé via assembly_identity_enabled=true.
  - path: {{ assembly_identity_fragment }}
{% endif %}
{% if assembly_payment_enabled %}
  # payment-service : fragment STATIQUE du dépôt (build depuis les sources),
  # référencé par CHEMIN ABSOLU (co-localisé avec Dockerfile + src/), pas rendu
  # sous {{ assembly_compose_dir }}. DÉFAUT désactivé (intégration pas encore
  # prouvée bout-en-bout) — activé via assembly_payment_enabled=true.
  - path: {{ assembly_payment_fragment }}
{% endif %}
{% if assembly_travel_enabled %}
  # travel-service : fragment STATIQUE du dépôt (build depuis les sources),
  # référencé par CHEMIN ABSOLU (co-localisé avec Dockerfile + src/), pas rendu
  # sous {{ assembly_compose_dir }}. DÉFAUT désactivé (intégration pas encore
  # prouvée bout-en-bout) — activé via assembly_travel_enabled=true.
  - path: {{ assembly_travel_fragment }}
{% endif %}

services:
  # Profils appliqués par merge sur les services inclus (Compose spec : les attributs
  # du fichier top-level FUSIONNENT avec les services inclus de même nom).
  postgres:
    profiles: [core, full]

  vault:
    profiles: [core, full]

  # Neo4j = poste RAM le plus lourd (~600 Mo–1 Go, cf. §4).
  # Exclu du profil core pour libérer ~1 Go en dev quotidien.
  neo4j:
    profiles: [full]

  # traefik : profil [core, full] — présent MÊME en core.
  # Justification : Traefik est le SEUL point d'entrée du système (le seul port
  # publié, 443). Sans lui, aucun service routé n'est joignable, même en dev
  # quotidien. Il doit donc rester dans "core" ; l'exclure rendrait la stack core
  # inaccessible de l'extérieur. Profils appliqués par merge sur le service inclus
  # (même mécanisme que postgres/vault ci-dessus).
{% if assembly_jenkins_enabled %}
  # `ci` AJOUTÉ à la liste (core/full inchangés) : l'UI Jenkins est exposée par
  # une route Traefik (labels sur le service jenkins), donc `--profile ci` seul
  # doit faire monter la gateway, sinon l'UI serait injoignable. Ajout émis
  # UNIQUEMENT si assembly_jenkins_enabled=true => le rendu par défaut reste
  # strictement identique à ce qu'il était.
  traefik:
    profiles: [core, full, ci]
{% else %}
  traefik:
    profiles: [core, full]
{% endif %}
{% if assembly_identity_enabled %}

  # identity-service : profil [full] uniquement pour l'instant (pas core).
  # Pas encore de raison de le charger dans le dev quotidien ; à revalider si le
  # service devient utilisé au quotidien. Profils appliqués par merge sur le
  # service inclus (même mécanisme que postgres/vault/neo4j ci-dessus).
  identity-service:
    profiles: [full]
{% endif %}
{% if assembly_payment_enabled %}

  # payment-service : profil [full] uniquement (pas core), même raisonnement
  # qu'identity-service. Bloc émis uniquement si assembly_payment_enabled=true.
  # Profils appliqués par merge sur le service inclus (même mécanisme que
  # postgres/vault/neo4j ci-dessus).
  payment-service:
    profiles: [full]
{% endif %}
{% if assembly_travel_enabled %}

  # travel-service : profil [full] uniquement (pas core). Dépend de neo4j (lui-même
  # profil [full] uniquement) : le charger en core n'aurait pas de sens sans sa base.
  # Bloc émis uniquement si assembly_travel_enabled=true. Profils appliqués par merge
  # sur le service inclus (même mécanisme que postgres/vault/neo4j ci-dessus).
  travel-service:
    profiles: [full]
{% endif %}
{% if assembly_jenkins_enabled %}

  # jenkins : profil [ci] EXCLUSIVEMENT — jamais core, jamais full.
  # docs/architecture-decisions.md §8 : Jenkins (~700 Mo au repos, 1,6 Go de
  # mem_limit ici car les builds tournent sur le controleur) NE COHABITE PAS
  # avec la stack applicative sur une machine à 8 Go. La CI se lance à la
  # demande, idéalement stack applicative down, puis on l'arrête.
  # Profils appliqués par merge sur le service inclus (même mécanisme que
  # postgres/vault/neo4j ci-dessus).
  jenkins:
    profiles: [ci]
{% endif %}