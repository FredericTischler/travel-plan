// =============================================================================
// payment-service — pipeline CI (increment CI/CD n°2 : generalisation multi-jobs).
//
// Calque STRICT du Jenkinsfile d'identity-service : memes stages, memes
// garde-fous, meme commande Maven. Seuls changent le repertoire du module et le
// chemin des rapports JUnit. Cette uniformite est voulue : trois pipelines qui
// divergeraient "un peu" seraient trois pipelines a debugger separement.
//
// DECLENCHEMENT : MANUEL UNIQUEMENT.
//   Aucun bloc `triggers { ... }` ici, et le config.xml du job (rendu par le
//   role Ansible `jenkins`, template generique job-pipeline.xml.j2) porte un
//   `<triggers/>` vide. Pas de pollSCM, pas de webhook, pas de scan multibranch :
//   ce sont des increments separes. Ce pipeline se lance au bouton "Build Now"
//   ou via l'API REST / `jenkins-cli build`.
//
// CE QUE CE PIPELINE FAIT : checkout + `./mvnw test`. RIEN D'AUTRE.
//   Pas d'analyse SonarQube, pas de `mvn package`, pas de build ni de push
//   d'image Docker, pas de deploiement.
//
// MAVEN / DEPOT DE DEPENDANCES :
//   `./mvnw test -B --no-transfer-progress`, aligne sur le Dockerfile du service
//   (qui joue `./mvnw package -DskipTests` : meme wrapper, memes flags, on ne
//   skippe simplement pas les tests ici). AUCUN `-s settings.xml`, AUCUN mirror :
//   les dependances viennent de Maven Central via le cache ~/.m2 du conteneur
//   Jenkins, persiste par le volume nomme JENKINS_HOME — donc deja chaud si un
//   autre job du monorepo a build avant (les 3 services partagent l'essentiel de
//   leurs dependances Spring Boot).
//
// TESTCONTAINERS :
//   Les tests de payment-service demarrent un VRAI postgres:17.5-bookworm
//   (PaymentServiceApplicationTests / PaymentLifecycleIntegrationTest /
//   PaymentUserOwnershipIntegrationTest). Le conteneur Jenkins doit donc avoir
//   acces au socket Docker et resoudre `host.docker.internal`. Ce cablage
//   (socket en lecture-ecriture + TESTCONTAINERS_HOST_OVERRIDE + extra_hosts
//   host-gateway + group_add du GID docker) est fait UNE FOIS dans le fragment
//   Compose du role Ansible `jenkins` : il est commun a tous les jobs, rien a
//   dupliquer ici. Sans lui, ce pipeline echoue au premier test — c'est attendu,
//   pas un bug du script.
// =============================================================================

pipeline {
    // Pas d'agent dedie dans cet increment : le build tourne sur le controleur.
    // Le fragment Compose dimensionne mem_limit en consequence (1600m) pour UN
    // build a la fois. Ne pas lancer les 3 jobs du monorepo en parallele.
    agent any

    options {
        // JENKINS_HOME vit dans un volume sur une machine a 8 Go : on borne
        // l'historique conserve (coherent avec le BuildDiscarder du config.xml).
        buildDiscarder(logRotator(numToKeepStr: '10'))
        // Deux builds concurrents = deux JVM Maven + deux JVM Surefire dans la
        // meme cgroup de 1600m => OOM kill garanti. On serialise.
        disableConcurrentBuilds()
        // Filet : un premier build telecharge Maven + tout le repo de deps.
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        // Heap de la JVM Maven bornee (meme discipline que les JVM du projet,
        // cf. docs/architecture-decisions.md §4). La JVM forkee par Surefire
        // reste container-aware et se borne sur mem_limit.
        MAVEN_OPTS = '-Xmx256m'
    }

    stages {

        stage('Checkout') {
            steps {
                // `scm` = la configuration Git du job (miroir local file://,
                // branche main). Aucun credential : rien a authentifier.
                checkout scm
            }
        }

        stage('Test') {
            steps {
                // Le Jenkinsfile est a la racine de payment-service, mais le
                // checkout ramene la RACINE DU DEPOT : on se place dans le
                // module avant de lancer le wrapper.
                dir('services/payment-service') {
                    // -B = batch (pas de couleurs/prompts), --no-transfer-progress
                    // = pas de barre de telechargement dans le log de build.
                    sh './mvnw test -B --no-transfer-progress'
                }
            }
        }
    }

    post {
        always {
            // Rend les resultats JUnit lisibles dans l'UI plutot que noyes dans
            // le log. Chemin par defaut de Surefire (le pom ne le surcharge pas).
            // allowEmptyResults:false => un run qui ne produit AUCUN rapport est
            // un echec, pas un "succes vide" trompeur.
            junit allowEmptyResults: false,
                  testResults: 'services/payment-service/target/surefire-reports/TEST-*.xml'
        }
    }
}
