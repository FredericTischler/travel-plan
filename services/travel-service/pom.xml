<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.3</version>
        <relativePath/>
    </parent>

    <groupId>com.travelplan</groupId>
    <artifactId>travel-service</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>travel-service</name>
    <description>Travel-Plan Travel Service — skeleton (Neo4j)</description>

    <properties>
        <java.version>21</java.version>
        <!-- Override Spring Boot BOM 3.4.x (1.20.5): docker-java 3.3.x in 1.20.x
             has a Unix socket transport bug that breaks API negotiation with Docker Engine 29.x.
             1.21.2 ships docker-java 3.4.x which fixes it.
             1.21.4 is required on top: TC 1.21.2 hardcodes API version 1.32 on the initial
             ping, which Docker Engine 29.x (minimum API 1.40) rejects. 1.21.4 tries 1.44
             first and only falls back to 1.32 on error, which fixes the negotiation.
             Same override as identity-service / payment-service, kept in sync. -->
        <testcontainers.version>1.21.4</testcontainers.version>
    </properties>

    <dependencies>
        <!-- Web (Actuator /actuator/health) -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Bean Validation — @Valid, @NotBlank on DTOs -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Actuator — exposes /actuator/health (Neo4jHealthContributorAutoConfiguration
             provides the "neo4j" health component natively once this starter + the
             Neo4j starter are both on the classpath — no custom HealthIndicator needed). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Spring Data Neo4j — version managed by the spring-boot-starter-parent BOM
             (3.4.3, verified against spring-boot-dependencies:3.4.3, no explicit
             version pinned here). Brings spring-data-neo4j + neo4j-java-driver
             (5.28.1, BOM-managed) + Neo4jAutoConfiguration. NOT spring-boot-starter-data-jpa:
             this service has no relational store. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-neo4j</artifactId>
        </dependency>

        <!-- JWT (jjwt 0.13.0 — same version as identity-service). api = compile-time
             interfaces; impl + jackson = runtime implementation. jjwt-jackson reuses
             the Jackson already on the classpath via spring-boot-starter-web (no
             extra JSON library). Used only by JwtService to VALIDATE tokens issued
             by identity-service — this service never generates a token, no Spring
             Security filter chain involved. -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>0.13.0</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>0.13.0</version>
            <scope>runtime</scope>
        </dependency>

        <!-- ===== TEST scope ===== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers — real Neo4j in tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>neo4j</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

        </plugins>
    </build>

</project>
